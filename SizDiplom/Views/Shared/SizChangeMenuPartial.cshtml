<h2>Возможные операции</h2>
<br />
<form id="sizChangeMenuForm" method="post" asp-action="" asp-controller="DeptAdmin" asp-anti-forgery="true">
</form>
<form asp-action="SizsUserIdChange" asp-controller="DeptAdmin">
        <div class="form-group">
            <label for="UserId">Выберите Работника :  </label>
            <select id="UserId" name="UserId">

                @foreach (User user in Model.usersList)
                {
                    <option value="@user.Id">@user.TabNom ___ @user.Login </option>
                }
            </select>
            <input type="hidden" id="SizId" name="SizId" value="@Model.SizId" />  <br />
            <br />
            <button type="submit" formmethod="post">Распределить СИЗ работнику</button>
        </div>
</form>        
        <br />
<form asp-action="SizsPlaceIdChange" asp-controller="DeptAdmin">
        <div class="form-group">
            <label for="PlaceId">Выберите Склад :  </label>
            <select id="PlaceId" name="PlaceId">

                @foreach (Place pl in Model.placesList)
                {
                    <option value="@pl.Id">@pl.Name ___ @pl.Description </option>
                }
            </select>
            <input type="hidden" id="SizId" name="SizId" value="@Model.SizId" />  <br />
            <br />
            <button type="submit" formmethod="post">Распределить СИЗ на склад</button>
        </div>
</form>
        <br />
<form asp-action="SizsCarIdChange" asp-controller="DeptAdmin">
        <div class="form-group">
            <label for="CarId">Выберите Автомобиль  :  </label>
            <select id="CarId" name="CarId">

                @foreach (Car car in Model.carsList)
                {
                    <option value="@car.Id">@car.CarNomber ___ @car.Description</option>
                }
            </select>
            <input type="hidden" id="SizId" name="SizId" value="@Model.SizId" />  <br />
            <br />
            <button formaction="SizsCarIdChange" formmethod="post">Распределить СИЗ в автомобиль</button>        
        </div>
</form>
        <br />
<form asp-action="" asp-controller="DeptAdmin">
        <div>            
            <input type="hidden" id="SizId" name="SizId" value="@Model.SizId"/>
        </div>
        <br />
        <div>

            <button asp-action="SizsBelongDelete" formmethod="post">Вывести СИЗ из распределения</button><br />
            <br />
            <br />
            <button asp-action="Index" formmethod="get">Выйти без изменений</button>            
            <button asp-action="SizDelete" formmethod="post">Удалить СИЗ</button>            
        </div>
</form>
       
   
