
<h2>Возможные операции</h2>
<br />
<form formmethod="post" asp-action="SizDetale" asp-controller="SizAdmin" asp-anti-forgery="true">
    <div class="validation" asp-validation-summary="ModelOnly"></div>
    

        <div class="form-group">
            <label for="Siz">Введите Инв. номер СИЗ:</label><br />
            <input type="text" name="SizNomber" maxlength="30" />
            
            <br />
            <input type="submit" formmethod="post" value="Посмотреть/Изменить данные СИЗ" >
            <br />
        </div>
</form>
        <br />
<form formmethod="post" asp-action="CheckNewDate" asp-controller="SizAdmin" asp-anti-forgery="true">

    <br />
        <div class=" form-group">
            <label for="CheckDate">Выберите дату следующей поверки СИЗ : </label>
            <input id="CheckDate" type="date" name="CheckDate" />
            <br />
            <input type="submit" formmethod="post" value="Вывести список СИЗ по дате" >
            <br />
        </div>     
</form>
