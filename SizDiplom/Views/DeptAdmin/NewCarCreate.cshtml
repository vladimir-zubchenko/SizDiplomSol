@model SizDiplom.ViewModels.CarChangeViewModel

<div class="wrapper">

    <div id="sidebar" class="aside">
        <h2>Страница ввода данных новой машины</h2>

    </div>

    <div id="article">
        <h2>Введите регистрационные данные ниже</h2>

        <br /><br />
        <form asp-action="NewCarCreate" asp-controller="DeptAdmin" asp-anti-forgery="true">
            <div class="validation" asp-validation-summary="ModelOnly"></div>
            <div>
                <div>
                    <label asp-for="CarNomber">Введите номер новой машины</label><br />
                    <input type="text" asp-for="CarNomber" /><br />
                    <span asp-validation-for="CarNomber"></span>
                </div>
                <br />
                <div>
                    <label asp-for="Description">Введите описание новой машины</label><br />
                    <input type="text" asp-for="Description" /><br />
                    <span asp-validation-for="Description"></span>
                </div>
                <br />
                <div>                    
                    <input type="hidden" asp-for="DepartmentId" value="@Model.DepartmentId" />                    
                    <input type="hidden" asp-for="Id" value="@Model.Id" />
                </div>
                <br />
                <br />
                <div>                    
                    <input type="submit" formmethod="post" value="СОХРАНИТЬ ДАННЫЕ" />
                </div>
                <br />
                <br />
                <button asp-action="Index" formmethod="get">ВЫЙТИ БЕЗ ИЗМЕНЕНИЙ</button>
               
                
            </div>
        </form>


    </div>
</div>