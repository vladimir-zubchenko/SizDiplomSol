@model SizDiplom.ViewModels.DepartAdminViewModel


<div class="wrapper">

    <div id="sidebar" class="aside">

        @await Html.PartialAsync("DeptAdminMenuPartial")

    </div>

    <div id="article">

        <h2>@ViewData["Title"]</h2>
        <h2>@ViewData["TitleMess"]</h2>

        <div>
            <table class="table">
                <tr><th>Инвентарный номер СИЗ</th><th>Дата следующей поверки</th><th>Название СИЗ</th></tr>

               
                    @foreach (Siz siz in Model.alarmSizsList)
                    {
                    <tr><td>@siz.TabNom </td> <td> @siz.NextCheckDate.ToShortDateString()</td> <td>@siz.Name </td></tr>
                    }
                            
            </table>
         </div>
            
     </div>  
     
</div>