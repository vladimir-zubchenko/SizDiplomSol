@model SizDiplom.ViewModels.PlaceChangeViewModel

<div class="wrapper">

    <div id="sidebar" class="aside">
        <h2>Страница коррекции данных склада</h2><br />
        
    </div>

    <div id="article">
        <h2>@ViewData["PlaceMessage"]</h2>
        <h2>Измените данные ниже</h2><br /><br />

        <form asp-action="ChangePlace" asp-controller="DeptAdmin" asp-anti-forgery="true">
            <div class="validation" asp-validation-summary="ModelOnly"></div>
            <div>
                <div>
                    <label asp-for="Name">Введите новое название склада</label><br />
                    <input type="text" asp-for="Name" /><br />
                    <span asp-validation-for="Name"></span>
                </div>
                <br />
                <div>
                    <label asp-for="Description">Введите новое описание склада</label><br />
                    <input type="text" asp-for="Description" /><br />
                    <span asp-validation-for="Description"></span>
                </div>
                <br />
                <div>                    
                    <input type="hidden" asp-for="DepartmentId" value="@Model.DepartmentId" />                    
                    <input type="hidden" asp-for="Id" value="@Model.Id" />
                </div>                
                <br />
                <br />
                <div>
                    <input type="submit" value="ИЗМЕНИТЬ ДАННЫЕ" />
                </div>
            </div>
        </form>
                <br />
                <br />
        <form asp-action="" asp-controller="DeptAdmin">
            <button asp-action="Index" formmethod="get">ВЫЙТИ БЕЗ ИЗМЕНЕНИЙ</button>
        </form>
                <br />
                <br />
        <form asp-action="DeletePlace" formmethod="post">
            <input type="hidden" asp-for="Id" value="@Model.Id" />            
            <button type="submit" formmethod="post">УДАЛИТЬ ДАННЫЕ СКЛАДА</button>
        </form>


    </div>
</div>