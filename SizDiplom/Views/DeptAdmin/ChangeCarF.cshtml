@model SizDiplom.ViewModels.CarChangeViewModel

<div class="wrapper">

    <div id="sidebar" class="aside">
        <h2>Страница коррекции данных машины</h2>

    </div>

    <div id="article">
        <h2>@ViewData["CarMessage"]</h2>
        <h2>Измените данные ниже</h2><br /><br />

        <form asp-action="ChangeCar" asp-controller="DeptAdmin" asp-anti-forgery="true">
            <div class="validation" asp-validation-summary="ModelOnly"></div>
            <div>
                <div>
                    <label asp-for="CarNomber">Введите новое номер машины</label><br />
                    <input type="text" asp-for="CarNomber" /><br />
                    <span asp-validation-for="CarNomber"></span>
                </div>
                <br />
                <div>
                    <label asp-for="Description">Введите новое описание машины</label><br />
                    <input type="text" asp-for="Description" /><br />
                    <span asp-validation-for="Description"></span>
                </div>
                <br />
                <div>                    
                    <input type="hidden" asp-for="DepartmentId" value="@Model.DepartmentId" />                    
                    <input type="hidden" asp-for="Id" value="@Model.Id" />
                </div>
                <br />
                <br />
                <div>
                    <input type="submit" value="ИЗМЕНИТЬ ДАННЫЕ" />

                </div>
            </div>
        </form>
                <br />
                <br />
        <form asp-action="Index" asp-controller="DeptAdmin">
            <button formmethod="get">ВЫЙТИ БЕЗ ИЗМЕНЕНИЙ</button>
        </form>
                <br />
                <br />
        <form asp-action="DeleteCar" asp-controller="DeptAdmin">
            <input type="hidden" asp-for="Id" value="@Model.Id" />
            <button type="submit" asp-action="DeleteCar" formmethod="post">УДАЛИТЬ ДАННЫЕ АВТОМОБИЛЯ</button>
        </form>


    </div>
</div>