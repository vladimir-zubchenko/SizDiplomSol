@model SizDiplom.ViewModels.UserChangeViewModel

<div class="wrapper">

    <div id="sidebar" class="aside">
        <h2>Страница коррекции регистрационных данных<br/> пользователя</h2>

    </div>

    <div id="article">
        <h2>@ViewData["UserMessage"]</h2>
        <h2>Измените регистрационные данные ниже</h2>

        <form asp-action="ChangeUser" asp-controller="DeptAdmin" asp-anti-forgery="true">
            <div class="validation" asp-validation-summary="ModelOnly"></div>
            <div>
                <div>
                    <label asp-for="Login">Введите Ваш Логин</label><br />
                    <input type="text" asp-for="Login" /><br />
                    <span asp-validation-for="Login"></span>
                </div>
                <br />
                <div>
                    <label asp-for="TabNom">Введите Ваш Табельный номер</label><br />
                    <input type="text" asp-for="TabNom" /><br />
                    <span asp-validation-for="TabNom"></span>
                </div>
                <br />
                <div>
                    <label asp-for="DepartmentName">@Model.DepartmentName</label>
                    <input type="hidden" asp-for="DepartmentName" value="@Model.DepartmentName" />                  
                    <input type="hidden" asp-for="DepartmentId" value="@Model.DepartmentId"/>                    
                    <input type="hidden" asp-for="Id" value="@Model.Id" /><br />
                </div>
                <br />
                <div>
                    <label asp-for="Password">Введите пароль</label><br />
                    <input asp-for="Password" value="@Model.Password" /><br />
                    <span asp-validation-for="Password"></span>
                </div>
                <br />
                <div>
                    <input type="hidden" asp-for="Role" value="@Model.Role" />
                </div>
                <br />
                <br />
                <div>
                    <input type="submit" value="ИЗМЕНИТЬ ДАННЫЕ" />                    
                </div>
            </div>
        </form>
                <br /> 
        <form asp-action="Index" asp-controller="DeptAdmin">
             <button formmethod="get">ВЫЙТИ БЕЗ ИЗМЕНЕНИЙ</button>
        </form>
                <br />
                <br />
        <form asp-action="DeleteUser" asp-controller="DeptAdmin">
            <input type="hidden" asp-for="Id" value="@Model.Id" />           
            <button type="submit" formmethod="post">УДАЛИТЬ ДАННЫЕ РАБОТНИКА</button>
        </form>
    </div>
</div>