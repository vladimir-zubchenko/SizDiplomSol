@model SizDiplom.ViewModels.AdmEditViewModel

@*AdminsEditController/AdminDetails  *@

<div class="wrapper">

    <div id="sidebar" class="aside">

        @await Html.PartialAsync("DepartmentMenuPartial")

    </div>

    <div id="article">

        <h2>@ViewData["Title"]</h2>
        <h2>@ViewData["Warning"]</h2>
        <br />
        <form asp-action="Edit" asp-controller="AdminsEdit" asp-anti-forgery="true">
            <div class="validation" asp-validation-summary="ModelOnly"></div>
            <div>
                <div>
                    <label asp-for="Login">Введите Логин</label><br />
                    <input type="text" asp-for="Login" /><br />
                    <span asp-validation-for="Login"></span>
                </div>
                <br />
                <div>
                    <label asp-for="TabNom">Введите Табельный номер</label><br />
                    <input type="text" asp-for="TabNom" /><br />
                    <span asp-validation-for="TabNom"></span>
                </div>
                <br />                
                <div>
                    <label asp-for="Password">Введите пароль</label><br />
                    <input asp-for="Password" value="@Model.Password" /><br />
                    <span asp-validation-for="Password"></span>
                </div>
                <br />
                <div>
                    <label>Роль сейчас - @Model.Role</label>
                    <label>Изменить роль на -</label><br />
                    <select id="Role" name="Role">
                        @foreach (string r in Model.Roles)
                        {
                            <option value="@r">@r </option>
                        }
                    </select>
                    <br />
                 
                    <input type="hidden" asp-for="DepartmentId" value="@Model.DepartmentId" />                 
                    <input type="hidden" asp-for="Id" value="@Model.Id" /><br />
                </div>                  
                <br />

                <div>
                    <input type="submit" value=" ИЗМЕНИТЬ ДАННЫЕ " />
                    <button type="submit" asp-action="Delete" asp-controller="AdminsEdit" formmethod="post">УДАЛИТЬ ДАННЫЕ АДМИНИСТРАТОРА</button>
                </div>
                
            </div>
        </form>               
                
       
        <br />
        <br />
        <form>

            <button asp-action="Index" asp-controller="Admin" formmethod="get">Выйти без изменений</button>
        </form>


    </div>

</div>
